{
  "manifest_version": 3,
  "name": "Dark Mode Sites",
  "version": "0.2.0",
  "description": "Mode sombre sur mesure réalisé par Thomas R.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-mode-sites@thomas-r",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Mode sombre",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" },
    "default_popup": "popup/popup.html",
    "default_area": "navbar"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ebay.fr/*", "*://*.ebay.com/*", "*://ebay.fr/*", "*://ebay.com/*", "*://*.ebaydesc.com/*"],
      "css": ["content/dark.css", "content/sites/ebay.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.amazon.fr/*", "*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.uk/*", "*://*.amazon.it/*",
        "*://*.amazon.es/*", "*://*.amazon.ca/*", "*://*.amazon.com.be/*", "*://*.amazon.nl/*"
      ],
      "css": ["content/dark.css", "content/sites/amazon.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://voir-anime.to/*", "*://*.voir-anime.to/*"],
      "css": ["content/dark.css", "content/sites/voir-anime.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://vinted.fr/*", "*://*.vinted.fr/*", "*://vinted.com/*", "*://*.vinted.com/*", "*://vinted.be/*", "*://*.vinted.be/*",
        "*://vinted.lu/*", "*://*.vinted.lu/*", "*://vinted.nl/*", "*://*.vinted.nl/*", "*://vinted.de/*", "*://*.vinted.de/*",
        "*://vinted.at/*", "*://*.vinted.at/*", "*://vinted.es/*", "*://*.vinted.es/*", "*://vinted.it/*", "*://*.vinted.it/*",
        "*://vinted.pt/*", "*://*.vinted.pt/*", "*://vinted.co.uk/*", "*://*.vinted.co.uk/*", "*://vinted.ie/*", "*://*.vinted.ie/*",
        "*://vinted.pl/*", "*://*.vinted.pl/*", "*://vinted.cz/*", "*://*.vinted.cz/*", "*://vinted.sk/*", "*://*.vinted.sk/*",
        "*://vinted.lt/*", "*://*.vinted.lt/*", "*://vinted.hu/*", "*://*.vinted.hu/*", "*://vinted.ro/*", "*://*.vinted.ro/*",
        "*://vinted.hr/*", "*://*.vinted.hr/*", "*://vinted.gr/*", "*://*.vinted.gr/*", "*://vinted.se/*", "*://*.vinted.se/*",
        "*://vinted.fi/*", "*://*.vinted.fi/*", "*://vinted.dk/*", "*://*.vinted.dk/*"
      ],
      "css": ["content/sites/vinted.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://act.hoyolab.com/bbs/event/signin/*"],
      "css": ["content/sites/hoyolab.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://hoyolab.com/*", "*://*.hoyolab.com/*"],
      "exclude_matches": ["*://act.hoyolab.com/bbs/event/signin/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://ameli.fr/*", "*://*.ameli.fr/*"],
      "css": ["content/dark.css", "content/sites/ameli.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://boursobank.com/*", "*://*.boursobank.com/*"],
      "css": ["content/dark.css", "content/sites/boursobank.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://caisse-epargne.fr/*", "*://*.caisse-epargne.fr/*"],
      "css": ["content/dark.css", "content/sites/caisse-epargne.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://riotgames.com/*", "*://*.riotgames.com/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://merch.riotgames.com/*"],
      "css": ["content/sites/riot-merch.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://vivinter.fr/*", "*://*.vivinter.fr/*"],
      "css": ["content/dark.css", "content/sites/vivinter.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://drive.google.com/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://gan.fr/*", "*://*.gan.fr/*",
        "*://ganassurances.fr/*", "*://*.ganassurances.fr/*"
      ],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://laposte.fr/*", "*://*.laposte.fr/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://192.168.1.1/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://etsy.com/*", "*://*.etsy.com/*", "*://etsy.me/*", "*://*.etsy.me/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://gifteo.fr/*", "*://*.gifteo.fr/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://ppbo.ws/*", "*://*.ppbo.ws/*"],
      "css": ["content/dark.css"],
      "js": ["sites.js", "content/toggle.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
